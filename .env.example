# ==============================================================================
# SolarGuard AI — Configuración de Entorno (Plantilla sin secretos reales)
# Copiar a `.env` para personalizar proveedor LLM, umbrales y recursos CPU.
# ==============================================================================

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
SOLARGUARD_LOG_LEVEL=INFO

# Colores ANSI en stdout (1 = habilitado, 0 = deshabilitado)
SOLARGUARD_COLOR_LOGS=1

# Semilla global de reproducibilidad y límite de hilos de CPU (anti-bloqueo)
SOLARGUARD_SEED=42
SOLARGUARD_MAX_CPU_THREADS=4

# Umbrales del sistema MoE (Mixture of Experts) y RAG
SOLARGUARD_DISCREPANCY_PCT=15.0
SOLARGUARD_VISION_CONF_THRESHOLD=0.60
SOLARGUARD_YOLO_CONF_THRESHOLD=0.25
SOLARGUARD_RAG_MIN_SCORE=0.20

# Proveedor LLM: "offline" (determinista sin internet), "ollama", "openai", "gemini"
SOLARGUARD_LLM_PROVIDER=offline
SOLARGUARD_LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Claves opcionales si se usa LLM externo (NUNCA subir `.env` real al repositorio)
OPENAI_API_KEY=
GOOGLE_API_KEY=
